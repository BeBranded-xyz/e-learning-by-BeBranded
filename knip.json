{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "ignoreBinaries": ["playwright", "ffmpeg"]
    },
    "packages/*": {
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/db": {
      "entry": ["src/bin.ts", "scripts/*.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/editor": {
      "entry": ["src/server/browser-guard.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/server": {
      "entry": ["src/browser-guard.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/next": {
      "entry": ["src/browser-guard.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/export": {
      "entry": ["src/browser-guard.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/video": {
      "entry": ["src/browser-guard.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/react": {
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
    },
    "packages/admin": {
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
    }
  }
}
