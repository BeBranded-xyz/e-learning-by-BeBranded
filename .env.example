# Environment variables for e-learning by BeBranded
#
# The packages read no environment variable themselves: the host passes
# configuration to createElearning() (docs/specifications/04-integration.md).
# This file lists the variables the integration example and apps/demo use.
# Names only, never values. Real values live in the host's secret store.

# --- Database (host database or dedicated database) -------------------------
ELEARNING_DATABASE_URL=       # Postgres connection string, server-only

# --- Cloudflare Stream (default video provider) -----------------------------
CF_ACCOUNT_ID=                # Account identifier
CF_STREAM_API_TOKEN=          # Server-only, Stream edit permission only
CF_STREAM_SIGNING_KEY_ID=     # Signed playback key id
CF_STREAM_SIGNING_KEY=        # Server-only, signs playback tokens
CF_STREAM_WEBHOOK_SECRET=     # Server-only, verifies Stream webhooks
