{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":pinAllExceptPeerDependencies",
    "security:openssf-scorecard"
  ],
  "timezone": "Europe/Paris",
  "schedule": ["before 7am on monday"],
  "labels": ["dependencies"],
  "rangeStrategy": "pin",
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 7am on the first day of the month"] },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "schedule": ["at any time"],
    "prPriority": 10
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Group minor and patch updates into one weekly PR",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor and patch dependencies"
    },
    {
      "description": "Majors as separate PRs, never automerged",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major"]
    },
    {
      "description": "Automerge dev dependencies (minor/patch) when CI is green",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "GitHub Actions pinned to digests, grouped",
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "groupName": "github actions"
    },
    {
      "description": "Docker base images pinned to digests",
      "matchManagers": ["dockerfile"],
      "pinDigests": true
    }
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2
}
