{
  "name": "@bebranded/elearning-admin",
  "version": "0.0.0",
  "description": "Back-office React components of the BeBranded e-learning module: content tree, editors, access rules, assignments and reports.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeBranded-xyz/e-learning-by-BeBranded.git",
    "directory": "packages/admin"
  },
  "homepage": "https://github.com/BeBranded-xyz/e-learning-by-BeBranded#readme",
  "bugs": "https://github.com/BeBranded-xyz/e-learning-by-BeBranded/issues",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "@bebranded/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/admin.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"for (const file of ['admin.css','admin-base.css','workspace.css','authoring.css']) require('node:fs').copyFileSync('src/'+file,'dist/'+file)\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@bebranded/elearning-core": "workspace:^",
    "@bebranded/elearning-editor": "workspace:^",
    "@bebranded/elearning-react": "workspace:^",
    "@blocknote/core": "^0.56.0",
    "@blocknote/mantine": "^0.56.0",
    "@blocknote/react": "^0.56.0",
    "@tanstack/react-query": "^5.104.5"
  },
  "devDependencies": {
    "@mantine/core": "9.6.2",
    "@mantine/hooks": "9.6.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "@mantine/core": "^8.3.11 || ^9.0.2",
    "@mantine/hooks": "^8.3.11 || ^9.0.2"
  }
}
