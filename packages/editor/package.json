{
  "name": "@bebranded/elearning-editor",
  "version": "0.0.0",
  "description": "BlockNote block schema and server-side lesson rendering of the BeBranded e-learning module.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeBranded-xyz/e-learning-by-BeBranded.git",
    "directory": "packages/editor"
  },
  "homepage": "https://github.com/BeBranded-xyz/e-learning-by-BeBranded#readme",
  "bugs": "https://github.com/BeBranded-xyz/e-learning-by-BeBranded/issues",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "@bebranded/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "@bebranded/source": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "browser": "./dist/server/browser-guard.js",
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@bebranded/elearning-core": "workspace:^",
    "@blocknote/core": "^0.56.0",
    "prosemirror-state": "^1.4.4",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@types/sanitize-html": "2.16.2"
  }
}
